# Project 3, U-Boot: the 10-uboot variant.
#
# The marker, plus everything this bench can stop U-Boot doing. Built on
# top of Project 2's configuration through NEO_EXTRA_FRAGMENT, and
# measured against the baseline, which carries marker.config and nothing
# else from this project.

# The marker, repeated here rather than chained, because a variant is one
# file and a fragment that depends on another fragment having been merged
# first is a fragment that will one day be merged alone.
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="gpio set PG11"
CONFIG_CMD_GPIO=y

# The boot delay itself. Project 2 builds with 2 seconds.
#
# The console stays usable: autoboot stops on a key press as long as
# as long as keyed autoboot is NOT set. Setting CONFIG_AUTOBOOT_KEYED,
# with a key sequence, makes
# a zero delay uninterruptible and the board can then only be recovered by
# reflashing.
CONFIG_BOOTDELAY=0

# Distro boot probes what it is configured to probe, and none of these can
# find anything on this bench. Each one costs time in the phase between
# the D1 marker and the first console byte, which is the phase this
# variant exists to shorten.
#
# These are kconfig directives and NOT comments. "# CONFIG_X is not set"
# is how a fragment turns an option off, and merge_config.sh treats it as
# a value. It is also the reason the build script cannot verify them: its
# check skips lines beginning with a hash, so these are merged and never
# confirmed. Check them on the board instead, where "usb" and "dhcp"
# should not be commands U-Boot has.
# CONFIG_USB is not set
# CONFIG_CMD_PXE is not set
# CONFIG_CMD_DHCP is not set

# The remaining scan is of the empty SD slot, and that is removed in the
# environment rather than in the configuration:
#
#     setenv boot_targets mmc1
#     saveenv
#
# mmc1 is the eMMC as U-Boot numbers it on this board. Confirm the number
# against "mmc list" on the board before saving, because getting it wrong
# leaves a board that boots nothing and has to be recovered over the
# console.
