# Project 3, U-Boot fragment. Applied on top of the Project 2 configuration.
#
# TWO STAGES IN ONE FILE, and the order they are added in matters for the
# measurement rather than for the build.
#
# Stage 1, the marker only. It has to be measured with the BASELINE U-Boot
# still in place, or the first variant already contains an optimisation and
# there is nothing to compare against.
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="gpio set PG11"
CONFIG_CMD_GPIO=y

# Stage 2, the 10-uboot variant. Comment these out for the 00-baseline run.
#
# BOOTDELAY=0 still leaves the console usable: autoboot stops on a key
# press as long as CONFIG_AUTOBOOT_KEYED is NOT set. Setting it, with a key
# sequence, makes a zero delay uninterruptible and the board can then only
# be recovered by reflashing.
CONFIG_BOOTDELAY=0

# Distro boot probes what it is configured to probe. None of these can find
# anything on this bench, and each one costs time in the phase between the
# D1 marker and the first console byte.
# CONFIG_USB is not set
# CONFIG_CMD_PXE is not set
# CONFIG_CMD_DHCP is not set

# The remaining scan is of the empty SD slot, and that is removed in the
# environment rather than in the configuration:
#
#     setenv boot_targets mmc1
#     saveenv
#
# mmc1 is the eMMC as U-Boot numbers it on this board. Confirm the number
# against "mmc list" on the board before saving, because getting it wrong
# leaves a board that boots nothing and has to be recovered over the
# console.
