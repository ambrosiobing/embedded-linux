# Project 2: every input this project builds from, pinned in one file.
#
#   . projects/02-neo-air-mainline/toolchain.env
#
# The build scripts refuse to run if this has not been sourced. That is not
# ceremony: an unpinned build of a bootloader is not reproducible, and this
# project's entire claim is that the boot chain is known from the SoC ROM
# upwards. A U-Boot built from whatever master happened to be that day
# cannot support that claim, and nothing in the resulting binary says so.
#
# SPDX-License-Identifier: MIT

# The cross toolchain. armhf, because the H3 is a 32-bit Cortex-A7 and the
# root filesystem is Debian armhf. No Arm Trusted Firmware is involved:
# that is a 64-bit concern, so unlike an A64 or H5 board this build has no
# external binary dependency at all.
export ARCH=arm
export CROSS_COMPILE=arm-linux-gnueabihf-

# Pinned versions. Tags, never branches.
#
# UBOOT_TAG moved from v2024.10 on 18 September 2026, and the reason is
# worth keeping because it is the pinned-input-meets-moving-host problem in
# its purest form.
#
# v2024.10 carries a copy of dtc whose pylibfdt typemaps call
# SWIG_Python_AppendOutput with two arguments. SWIG 4.3 added a third,
# is_void, and Ubuntu 26.04 ships SWIG 4.4, so the generated wrapper does
# not compile:
#
#   libfdt_wrap.c: error: too few arguments to function
#   'SWIG_Python_AppendOutput'; expected 3, have 2
#
# pylibfdt is not skippable here. u-boot-sunxi-with-spl.bin is a binman
# image and binman needs it.
#
# The alternatives were to patch a vendored copy of dtc inside a pinned
# tree, which makes the pin a lie, or to hold the host's SWIG back, which
# makes the build depend on an apt pin nothing in this repository can
# state. Moving the tag is the only option that leaves one honest number
# in one file.
export UBOOT_TAG=v2025.10
export KERNEL_TAG=v6.12
export DEBIAN_SUITE=bookworm
export DEBIAN_ARCH=armhf
export DEBIAN_MIRROR=http://deb.debian.org/debian

# The board, as three different names for the same thing, because three
# different build systems each want their own.
export UBOOT_DEFCONFIG=nanopi_neo_air_defconfig
export KERNEL_DEFCONFIG=sunxi_defconfig
export BOARD_DTB=sun8i-h3-nanopi-neo-air.dtb

# The root compatible string from that device tree, which is also the name
# brcmfmac derives its NVRAM filename from. It is here rather than inline
# in mkrootfs.sh because it is the same fact as BOARD_DTB above, written
# for a different consumer.
export BOARD_COMPATIBLE=friendlyarm,nanopi-neo-air

# Where the work happens, which is NOT inside this repository.
#
# A departure from the specification's layout, which puts an out/ directory
# in the project. This repository already learned that lesson expensively
# elsewhere: a build tree inside the checkout made every archived image
# report a dirty tree, so the record was wrong about the one thing it
# exists to get right. See .gitignore, which says so at length.
#
# Sources and artefacts therefore live beside the Yocto work tree and the
# repository holds only scripts, fragments and evidence.
#
# $HOME is not trustworthy here, and the step that needs root is exactly
# the step where that bites. Under sudo, $HOME is root's, so a default
# derived from it points at /root/bench and the tree the ordinary user
# built is invisible. "sudo -E" used to carry the variable across.
#
# On 18 September 2026 it stopped. The build host's sudo answers
#
#   sudo: preserving the entire environment is not supported,
#   '-E' is ignored
#
# and then runs the command anyway. A warning on stderr, every pin gone,
# and a script that looks in the wrong home directory.
#
# So the invoking user's home is recovered from SUDO_USER rather than read
# from $HOME. An explicit NEO_WORK or BENCH_WORK still wins, for a work
# tree somewhere else entirely.
_neo_home=$HOME
if [ "$(id -u)" = 0 ] && [ -n "${SUDO_USER:-}" ]; then
	_neo_home=$(getent passwd "$SUDO_USER" | cut -d: -f6)
	[ -n "$_neo_home" ] || _neo_home=$HOME
fi
export NEO_WORK=${NEO_WORK:-${BENCH_WORK:-$_neo_home/bench}/neo-air}
unset _neo_home
export NEO_SRC=${NEO_SRC:-$NEO_WORK/src}
# NEO_OUT is overridable so that a card can be written from an archived set
# rather than only from the live build tree:
#
#   sudo env NEO_OUT=<archive dir> ./go neo-air card /dev/sdX
#
# sdcard.sh and flash-emmc.sh read every artefact from here, so pointing it
# at an archive directory writes exactly what was archived. Set
# unconditionally it could not be pointed anywhere, which made the flash
# line in an archive's PROVENANCE.txt a claim the code did not support.
export NEO_OUT=${NEO_OUT:-$NEO_WORK/out}

# Marker the build scripts test for. Sourcing this file is what sets it, so
# a script cannot be run with a half-configured environment inherited from
# somewhere else.
export NEO_ENV=1
