# Project 2: the U-Boot options this bench needs on top of the board's own
# defconfig. Merged with scripts/kconfig/merge_config.sh, never by editing
# a .config.
#
# nanopi_neo_air_defconfig already selects the SoC, the DRAM timings, the
# SD controller and the console. Everything here is either something the
# defconfig leaves off or something a later project depends on.

# Two seconds at the prompt. Long enough to interrupt by hand when a boot
# is going wrong, short enough that Project 3, which measures and shortens
# this boot, has a number to shorten. Zero would make the board hard to
# rescue without FEL; the default of one is too brief to catch reliably on
# a console that has just started scrolling.
CONFIG_BOOTDELAY=2

# The eMMC controller. This is the line that matters most in the file.
#
# sunxi numbers its MMC slots, and the extra-slot option is what makes
# U-Boot probe mmc2 at all. Without it "mmc list" shows the SD card alone,
# the eMMC cannot be written from the U-Boot prompt, and the board cannot
# boot from it: the BROM would still find a bootloader at byte 8192 of the
# eMMC, but nothing before this project put one there.
#
# The symptom is not an error. It is a shorter "mmc list" than expected,
# which reads as a hardware fault on a board whose eMMC is soldered down.
CONFIG_MMC_SUNXI_SLOT_EXTRA=2

# Commands used by hand during bring-up and by the FEL recovery path:
# writing the bootloader back onto a blanked eMMC is "mmc write" from a
# U-Boot that was itself loaded over USB.
CONFIG_CMD_MMC=y
CONFIG_CMD_GPIO=y
