def read_conf(path):
    """Key=value, with the three Windows traps Project 1 lost a board to.

    A byte order mark on the first key, CRLF endings, and a final line with
    no newline. The third is the one that bites: a plain read loop ends
    before the body runs and silently drops the last key, which is usually
    the one most recently added.
    """
    conf = dict(DEFAULTS)
    try:
        with open(path, "r", encoding="utf-8-sig") as handle:
            text = handle.read()
    except FileNotFoundError:
        return conf
    for raw in text.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        conf[key.strip()] = value.strip().strip('"')
    return conf


def make_payload(conf):
    """What one report carries.

    Short on purpose. Every byte is radio time and radio time is charge,
    and a tracker that reports JSON with field names spends more of its
    battery on the word "latitude" than on the number.
    """
    return ("%d,%s" % (int(time.time()), conf.get("coap_path", ""))).encode()


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="attach, report one position, sleep")
    parser.add_argument("-c", "--conf", default=CONF)
    parser.add_argument("-p", "--port",
                        help="override the AT port; a FIFO works, which is "
                             "how the test drives this with no modem")
    parser.add_argument("--mode", default="3",
                        choices=["1", "2", "3"],
                        help="1 Cat-M, 2 NB-IoT, 3 let the modem choose")
    parser.add_argument("--once", action="store_true",
                        help="one report, then exit; the normal mode, "
                             "because a timer starts the next one")
    parser.add_argument("--no-power", action="store_true",
                        help="skip PWRKEY: the modem is already on")
    parser.add_argument("-v", "--verbose", action="store_true")
    args = parser.parse_args(argv)

    def log(message):
        sys.stderr.write("tracker: %s\n" % message)
        sys.stderr.flush()

    quiet = log if args.verbose else (lambda msg: None)
    conf = read_conf(args.conf)
    port = AtPort(args.port or conf["port"], int(conf["baud"]), log=quiet)
    try:
        port.open()
    except OSError as exc:
        log("cannot open %s: %s" % (args.port or conf["port"], exc))
        return 2

    tracker = Tracker(conf, port, log=log)
    try:
        if not args.no_power:
            tracker.power_on()
        else:
            tracker.to("BOOTING", "--no-power")
        if tracker.wait_ready() == "FAILED":
            return 1
        tracker.configure(mode=args.mode)
        if tracker.attach() == "FAILED":
            return 1
        tracker.read_psm()
        # Guarded rather than unconditional. Written without the guard, a
        # report that reached BACKOFF was immediately moved to ASLEEP by
        # the next line, so the program exited reporting the one state that
        # means everything went well. A failure that overwrites itself with
        # a success is worse than a crash.
        if tracker.report(make_payload(conf)) == "REGISTERED":
            tracker.sleep_until_next()
        else:
            log("backing off for %.0f s before the next report"
                % tracker.backoff_delay())
    except AtError as exc:
        log("modem: %s" % exc)
        return 1
    finally:
        port.close()
    return 0 if tracker.state == "ASLEEP" else 1


if __name__ == "__main__":
    sys.exit(main())
