[Unit]
Description=Collect modem metrics every 30 seconds

[Timer]
OnBootSec=60
OnUnitActiveSec=30
# The collector is cheap but it does talk to the modem. Without this, a
# board whose clock jumps at first NTP sync fires a burst of runs.
AccuracySec=5s
Unit=lte-exporter.service

[Install]
WantedBy=timers.target
