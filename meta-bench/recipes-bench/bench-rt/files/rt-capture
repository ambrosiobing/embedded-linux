#!/usr/bin/env python3
"""Record CH0 of an MCC 118 into a .npy file.

    rt-capture --seconds 60 --out /dev/shm/run.npy

This is the external instrument. rt-run pins it to the housekeeping cores
with taskset, and it raises its own priority there, for the reason below.

Four properties of the scan matter enough to be spelled out:

SCHED_FIFO 60, set by this program rather than by its caller.

    The first version ran at ordinary priority, on the argument that a
    capture process competing with the task it measures would be measuring
    itself. That argument is about the measured core. It does not apply to
    the housekeeping cores, where the instrument competes with the load
    instead, and on 17 September 2026 it lost: two runs of rt-run -L died
    with

        rt-capture: overrun after 1480000 samples, discarding the run
        rt-capture: overrun after 120000 samples, discarding the run

    stress-ng runs --cpu 3 --vm 2 --vm-bytes 128M --hdd 1 on the same three
    cores, so six workers were scheduled against one Python reader and a
    one second ring buffer lost a second inside 1.2 s of reading.

    The load exists to perturb the measured core, not the recorder. 60 sits
    below rt-toggle's 80, so the thing being measured still wins, and this
    process spends nearly all its life blocked in the library waiting for
    data, so it does not starve the housekeeping cores in practice.

    WHERE IT IS SET MATTERS AS MUCH AS THAT IT IS SET. The library spawns
    its own reader thread inside a_in_scan_start, and on Linux a thread
    inherits its creator's scheduling policy. Setting the priority after
    that call would raise this Python loop and leave the thread that
    actually drains SPI at ordinary priority, which is the half that was
    starving. It is set before, and the test asserts the ordering.

    The board has neither chrt nor nice, and BusyBox carries neither as an
    applet, so doing it in the caller was not available even if it were the
    better place.

Continuous mode with chunked reads. The library keeps a ring buffer and
fills it from an interrupt; the reader has to drain it faster than the
converter fills it. Reading in 10000-sample chunks means about ten reads a
second at 100 kS/s.

    The original text here said that was "slack enough that an ordinary
    scheduling delay on a loaded housekeeping core cannot overrun the
    buffer". It was written from arithmetic, never tested under load, and
    the board disproved it twice in three minutes. The slack is real; the
    scheduling delay was not ordinary.

Overruns discard the run, not the chunk. The library reports
hardware_overrun and buffer_overrun per read. A run with a gap in it still
produces a plausible histogram, because a missing edge looks exactly like
one long period and lands in the tail that this project exists to measure.
Silently keeping such a run would be the single easiest way to publish a
wrong number, so the run is thrown away and said so.

float32 on the way out. The library allocates float64 internally, so a 60 s
scan is 48 MB in memory; on disk it is 24 MB as float32. The converter is
12 bits over a 20 V span, which is 5 mV per code, and float32 resolves that
with about five significant digits to spare.

SPDX-License-Identifier: MIT
"""

import argparse
import os
import sys
import time

import numpy as np

# SCHED_FIFO 60. Below rt-toggle's 80 so the measured task still wins, and
# above the load so the instrument is not part of what is being measured.
CAPTURE_PRIORITY = 60


def raise_priority():
    """Ask for SCHED_FIFO, and say so if refused rather than proceeding quietly.

    Refusal is survivable: the scan still runs, and an overrun is reported
    rather than hidden, so a starved run is thrown away instead of
    published. But a run that quietly took the slow path and happened not
    to overrun would be a row taken under conditions no column records,
    which is worse than a missing row.
    """
    try:
        os.sched_setscheduler(0, os.SCHED_FIFO,
                              os.sched_param(CAPTURE_PRIORITY))
        return True
    except (AttributeError, OSError) as error:
        print("rt-capture: could not set SCHED_FIFO %d: %s"
              % (CAPTURE_PRIORITY, error), file=sys.stderr)
        print("rt-capture: continuing at ordinary priority; under load this "
              "is where overruns come from", file=sys.stderr)
        return False


def parse_args(argv):
    parser = argparse.ArgumentParser(
        description="continuous MCC 118 scan of one channel to a .npy file")
    parser.add_argument("--seconds", type=float, default=60.0)
    parser.add_argument("--rate", type=float, default=100000.0)
    parser.add_argument("--channel", type=int, default=0)
    parser.add_argument("--address", type=int, default=0,
                        help="HAT address set by the A0..A2 links")
    parser.add_argument("--chunk", type=int, default=10000,
                        help="samples per read (default 10000)")
    parser.add_argument("--out", default="capture.npy")
    return parser.parse_args(argv)


def main(argv):
    args = parse_args(argv)

    # Imported here rather than at the top so that --help works, and fails
    # readably, on a machine with no HAT and no vendor library.
    try:
        from daqhats import mcc118, OptionFlags
    except ImportError as error:
        print("rt-capture: the daqhats library is not installed: %s" % error,
              file=sys.stderr)
        print("It is in bench-rt-image as libdaqhats and python3-daqhats.",
              file=sys.stderr)
        return 1

    board = mcc118(args.address)

    # BEFORE a_in_scan_start, not after. The library's reader thread is
    # created in that call and inherits this policy; raising the priority
    # afterwards would leave that thread, which is the one that drains SPI,
    # at ordinary priority. See the module docstring.
    raise_priority()

    # samples_per_channel sizes the ring buffer, not the run. One second of
    # data is a compromise: large enough that a stalled reader has a second
    # to recover, small enough that an overrun is detected while the run is
    # still short enough to repeat.
    board.a_in_scan_start(channel_mask=1 << args.channel,
                          samples_per_channel=int(args.rate),
                          sample_rate_per_channel=args.rate,
                          options=OptionFlags.CONTINUOUS)

    chunks = []
    total = 0
    overran = False
    deadline = time.monotonic() + args.seconds
    try:
        while time.monotonic() < deadline:
            result = board.a_in_scan_read_numpy(
                samples_per_channel=args.chunk, timeout=5.0)
            if result.hardware_overrun or result.buffer_overrun:
                print("rt-capture: overrun after %d samples, discarding the "
                      "run" % total, file=sys.stderr)
                overran = True
                break
            if result.data.size:
                chunks.append(result.data.astype(np.float32))
                total += result.data.size
    finally:
        board.a_in_scan_stop()
        board.a_in_scan_cleanup()

    if overran:
        return 2
    if not chunks:
        print("rt-capture: no samples returned", file=sys.stderr)
        return 1

    np.save(args.out, np.concatenate(chunks))
    print("%d samples at %.0f S/s -> %s" % (total, args.rate, args.out))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
