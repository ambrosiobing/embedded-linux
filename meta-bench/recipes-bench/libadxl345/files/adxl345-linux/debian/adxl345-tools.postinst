#!/bin/sh
# Create the i2c group if the distribution has not, then reload udev so
# the rule applies to devices that already exist. Without the reload the
# rule takes effect at the next boot, which makes the package look
# broken to anyone who installs it and tries it immediately.
set -e

case "$1" in
configure)
	for g in i2c gpio; do
		if ! getent group "$g" >/dev/null; then
			addgroup --system "$g"
		fi
	done
	# The service runs as this user, which owns nothing and can log in
	# nowhere. Created here rather than shipped in /etc/passwd, because a
	# package that ships accounts is a package that fights the admin.
	if ! getent passwd adxl345 >/dev/null; then
		adduser --system --no-create-home --group adxl345
	fi
	for g in i2c gpio; do
		if getent group "$g" >/dev/null; then
			adduser adxl345 "$g" >/dev/null || true
		fi
	done

	if [ -d /run/udev ]; then
		udevadm control --reload-rules || true
		udevadm trigger --subsystem-match=i2c || true
	fi
	echo "adxl345-tools: add yourself to the i2c group to read the"
	echo "               sensor without root:  adduser \$USER i2c"
	;;
esac

#DEBHELPER#
exit 0
