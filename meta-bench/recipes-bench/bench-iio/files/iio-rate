#!/bin/sh
#
# iio-rate - the three ways out of a sensor, measured the same way.
#
#   iio-rate poll     DEVICE [-d SEC]
#   iio-rate trigger  DEVICE HZ [-d SEC]
#   iio-rate fifo     DEVICE HZ WATERMARK [-d SEC]
#
# DEVICE is a name as it appears in /sys/bus/iio/devices/iio:deviceN/name,
# for example lsm6dsv16x_accel or lis2mdl, not a path. Which iio:deviceN a
# driver got is decided at probe time and changes between boots; the name
# does not.
#
# WHAT IS COMPARABLE HERE AND WHAT IS NOT
#
# Three paths, and they do not all produce the same kind of number.
#
#   poll      user space reads a sysfs attribute in a loop. Every read is
#             an I2C transaction started by a system call. There are no
#             timestamps at all.
#   trigger   the kernel fires a hrtimer, the IIO core captures one scan
#             and timestamps it as it pushes it. The jitter of those
#             timestamps is real kernel latency.
#   fifo      the sensor fills its own FIFO and raises an interrupt at a
#             watermark. The driver drains N samples in one burst and
#             ASSIGNS timestamps by interpolating backwards from the
#             interrupt time using the configured rate.
#
# So a FIFO timestamp is not a measurement. Its spread is the driver's
# arithmetic and the sensor's oscillator, and it will look far better than
# the hrtimer path for the same reason a clock that reports the time it was
# set to always agrees with itself.
#
# This program therefore labels the ts_sd_us column with where the
# timestamps came from, and refuses to print a comparison between the two.
# docs/DESIGN.md has the argument. What IS comparable across all three:
# interrupts per second, the reader's CPU time, and samples delivered
# against samples asked for.
#
# BENCH_IIO_ROOT relocates /sys and /proc for tests/iio-rate-test.sh.
#
# SPDX-License-Identifier: MIT

set -eu

ROOT=${BENCH_IIO_ROOT:-}
SYS=$ROOT/sys
PROC=$ROOT/proc
RESULTS=${BENCH_IIO_RESULTS:-/var/lib/bench/iio}
DURATION=${BENCH_IIO_DURATION:-10}

die() {
	echo "iio-rate: $*" >&2
	exit 1
}

note() {
	echo "--- $*"
}

usage() {
	sed -n '3,8p' "$0" | sed 's/^# \{0,1\}//'
	exit 2
}

# A device is found by name, never by index.
#
# Which iio:deviceN a driver gets depends on probe order, which depends on
# the order the i2c bus enumerated, which is not a promise. A results table
# whose rows say "iio:device0" is a table that means something different
# after the next reboot.
device_path() {
	_want=$1
	for d in "$SYS"/bus/iio/devices/iio:device*; do
		[ -e "$d/name" ] || continue
		[ "$(cat "$d/name")" = "$_want" ] || continue
		printf '%s' "$d"
		return 0
	done
	die "no IIO device named $_want.
       iio-probe lists what is present, and says whether the driver is
       missing from the image or merely unbound."
}

# TWO NAMES FOR THE SAME KNOB, and this program knew only one until it
# met Project 5's driver on Friday 9 October 2026.
#
# A driver that declares its rate shared by all channels exposes
# sampling_frequency at the device level; the ST drivers do. One that
# declares it shared by type exposes in_<type>_sampling_frequency instead;
# mainline's ADXL345 driver does, and Project 5's copies mainline so that
# the two present the same files to the same tools. Writing to the first
# name on the second kind of device fails with "Permission denied", which
# reads like a privilege problem and is a missing file.
rate_attr_of() {
	_dev=$1
	if [ -w "$_dev/sampling_frequency" ]; then
		printf '%s' "$_dev/sampling_frequency"
		return 0
	fi
	for _f in "$_dev"/in_*_sampling_frequency; do
		if [ -w "$_f" ]; then
			printf '%s' "$_f"
			return 0
		fi
	done
	die "$(basename "$_dev") exposes no writable rate attribute.
       Looked for sampling_frequency and in_*_sampling_frequency."
}

# ------------------------------------------------------------ accounting

# The reader's own CPU time, not the system's.
#
# /proc/stat would give a system-wide idle delta, which on an otherwise
# quiet board is close enough to be tempting and wrong: it counts the
# shell, the stubs and anything else that woke up. The acceptance criterion
# is about the reader, so the reader is what is measured, from its own
# /proc/PID/stat before it is reaped.
cpu_ticks_of() {
	_pid=$1
	_stat=$PROC/$_pid/stat
	[ -r "$_stat" ] || { echo 0; return 0; }
	# Fields 14 and 15 are utime and stime, counted from the end of the
	# comm field, because a process name may contain spaces and
	# parentheses and the naive cut on field 14 is wrong for exactly the
	# processes whose names are interesting.
	#
	# Children are counted too, fields 16 and 17, which are cutime and
	# cstime. For a reader that is one process, dd on the buffer, they
	# are zero and nothing changes. For the poll path the reader IS a
	# shell loop whose work happens in forks, and counting only its own
	# two fields reports a loop that is busy as using nothing.
	sed 's/.*) //' "$_stat" | awk '{print $12 + $13 + $14 + $15}'
}

clock_ticks() {
	getconf CLK_TCK 2>/dev/null || echo 100
}

irq_count_of() {
	# The IMU's interrupt is named after its driver in /proc/interrupts.
	# Summing every CPU column matters on a four-core board where an
	# interrupt may be steered elsewhere between two reads.
	_match=$1
	[ -r "$PROC/interrupts" ] || { echo 0; return 0; }
	awk -v m="$_match" '
		index($0, m) > 0 {
			total = 0
			for (i = 2; i <= NF; i++) {
				if ($i ~ /^[0-9]+$/) { total += $i }
			}
			print total
			found = 1
			exit
		}
		END { if (!found) print 0 }
	' "$PROC/interrupts"
}

# --------------------------------------------------------- buffer control

scan_enable() {
	_dev=$1
	shift
	for _c in "$@"; do
		_f=$_dev/scan_elements/${_c}_en
		[ -w "$_f" ] || die "no scan element $_c on $(basename "$_dev").
       The channels a device offers are in its scan_elements directory;
       asking for one it does not have is a typo, not a kernel problem."
		echo 1 >"$_f"
	done
}

buffer_off() {
	_dev=$1
	# Best effort and deliberately not fatal. This runs from a trap, and
	# a failure to disable a buffer that is already disabled must not
	# replace the real error with its own.
	echo 0 >"$_dev/buffer/enable" 2>/dev/null || true
}

# ONE EXIT TRAP, BECAUSE A SHELL HAS ONLY ONE.
#
# Until Saturday 17 October 2026 do_trigger set a trap to remove the
# trigger it had created, and capture() then set its own for the raw
# file, replacing it. The trigger's cleanup never ran once. On the bench
# that left the trigger registered AND attached after every trigger run,
# so the next "iio-rate fifo" enabled a buffer with a trigger attached,
# the IIO core took the triggered path, the driver left the part's
# hardware FIFO in bypass, and the row written said "fifo" and
# "driver-interpolated" over 984 samples that came from neither.
#
# A trap set in two places is a trap that runs in one, and nothing says
# so: no error, no warning, and the half that lost is the half that
# registered first.
CLEAN_DEV=
CLEAN_RAW=
CLEAN_TRIG=

cleanup() {
	[ -z "$CLEAN_RAW" ] || rm -f "$CLEAN_RAW"
	[ -z "$CLEAN_DEV" ] || buffer_off "$CLEAN_DEV"

	# The buffer first, then the detach, then the removal. The core
	# refuses to remove a trigger a device is using, and refuses to
	# change current_trigger while a buffer is enabled, so any other
	# order fails quietly and leaves exactly the state this exists to
	# prevent.
	if [ -n "$CLEAN_TRIG" ]; then
		[ -z "$CLEAN_DEV" ] ||
			echo >"$CLEAN_DEV/trigger/current_trigger" 2>/dev/null ||
			true
		iio-trigger remove "$CLEAN_TRIG" >/dev/null 2>&1 || true
	fi
}

trap cleanup EXIT INT TERM

# ------------------------------------------------------------- the paths

do_poll() {
	dev=$(device_path "$1")
	attr=${2:-in_accel_x_raw}
	[ -r "$dev/$attr" ] || die "no $attr on $1"

	note "path       poll"
	note "device     $1 at $(basename "$dev")"
	note "attribute  $attr"
	note "duration   ${DURATION}s"

	_start=$(date +%s)
	_deadline=$((_start + DURATION))
	_n=0
	_ticks_before=$(cpu_ticks_of $$)
	# Deliberately the naive loop, because the naive loop is the thing
	# being measured. Every iteration is an open, a read, a close and an
	# I2C transaction, and the number it produces is what a reader gets
	# for doing the obvious thing.
	while [ "$(date +%s)" -lt "$_deadline" ]; do
		cat "$dev/$attr" >/dev/null
		_n=$((_n + 1))
	done
	_elapsed=$(( $(date +%s) - _start ))
	[ "$_elapsed" -gt 0 ] || _elapsed=1

	# The loop's own cost, children included, because on this path the
	# cost IS the forks: every iteration is a date, a cat, an open, a
	# read and a close. Until Saturday 17 October 2026 this path passed
	# nothing here and emit printed a zero, so a figure nobody measured
	# sat in the results file beside figures somebody did.
	_ticks=$(( $(cpu_ticks_of $$) - _ticks_before ))
	cpu_pct=$(awk -v t="$_ticks" -v hz="$(clock_ticks)" -v s="$_elapsed" \
		'BEGIN { printf "%.2f", (hz > 0 && s > 0) ? 100 * t / hz / s : 0 }')

	emit poll "$1" "$((_n / _elapsed))" "$_n" "$_elapsed" 0 "" none
}

do_trigger() {
	name=$1
	hz=$2
	dev=$(device_path "$name")
	trig=${BENCH_IIO_TRIGGER:-iio-rate-t}

	note "path       hrtimer trigger"
	note "device     $name at $(basename "$dev")"
	note "rate       ${hz} Hz"

	iio-trigger add hrtimer "$trig" "$hz" >/dev/null

	# Registered with the one cleanup rather than trapped here. See the
	# comment above cleanup(): a second trap replaces the first, and
	# this is the one that used to lose.
	CLEAN_DEV=$dev
	CLEAN_TRIG=$trig

	echo "$trig" >"$dev/trigger/current_trigger"
	capture "$dev" "$name" trigger "$hz" iio-core
}

do_fifo() {
	name=$1
	hz=$2
	watermark=$3
	dev=$(device_path "$name")

	# THERE ARE TWO CONVENTIONS FOR A HARDWARE WATERMARK and this
	# program knew only one, which made it tell a part with a 4.5 kB
	# FIFO that it had none.
	#
	# hwfifo_watermark is an optional interface that a handful of
	# drivers expose directly. The standard one is buffer/watermark,
	# backed by .set_watermark in the driver's iio_buffer_setup_ops,
	# which the IIO core clamps to the hardware FIFO size. st_lsm6dsx
	# uses the second, so testing only for the first and concluding
	# "no hardware FIFO" was wrong about hardware that has one.
	#
	# And the deeper point, which the old check got backwards: the
	# NAME of an attribute does not establish that a watermark is
	# served by hardware. The interrupt rate does. A hardware FIFO at
	# rate R and watermark W interrupts R/W times a second; a software
	# buffer interrupts R times whatever the attribute is called. This
	# program already counts interrupts, so the proof is in the result
	# rather than in the probe, and the check below only has to find a
	# writable attribute.
	wm_attr=""
	for candidate in \
		"$dev/buffer/hwfifo_watermark" \
		"$dev/buffer/watermark" \
		"$dev/buffer0/watermark"; do
		if [ -w "$candidate" ]; then
			wm_attr="$candidate"
			break
		fi
	done

	[ -n "$wm_attr" ] ||
		die "$name exposes no writable watermark attribute.
       Looked for buffer/hwfifo_watermark, buffer/watermark and
       buffer0/watermark. Without one there is no way to batch, so
       there is no third path to measure on this device. The
       magnetometer is one such: that is why the trigger path is
       demonstrated there and the FIFO path here."

	# A TRIGGER ATTACHED HERE MEANS THIS PATH CANNOT RUN AT ALL.
	#
	# iio_verify_update picks the triggered mode whenever the device
	# declares it and has a trigger, and falls back to the software
	# mode otherwise. A driver whose buffer serves both paths then
	# leaves its hardware FIFO alone, and the capture measures the
	# trigger while this program reports the FIFO. That happened on
	# Saturday 17 October 2026, from a trigger this tool's own trigger
	# path had left behind.
	#
	# Detached rather than refused, because "iio-rate fifo" is an
	# explicit request for the path a trigger prevents, and said out
	# loud, because a tool that silently changes the state of a device
	# is how the next hour gets lost.
	if [ -r "$dev/trigger/current_trigger" ]; then
		_attached=$(cat "$dev/trigger/current_trigger" 2>/dev/null)
		if [ -n "$_attached" ]; then
			note "detached   trigger \"$_attached\", which would have"
			note "           made the core take the triggered path and"
			note "           leave the hardware FIFO in bypass"
			echo >"$dev/trigger/current_trigger" 2>/dev/null || true
		fi
	fi

	note "path       hardware FIFO"
	note "device     $name at $(basename "$dev")"
	note "rate       ${hz} Hz"
	note "watermark  $watermark via $(basename "$(dirname "$wm_attr")")/$(basename "$wm_attr")"

	rate_attr=$(rate_attr_of "$dev")
	echo "$hz" >"$rate_attr"
	note "rate via   $(basename "$rate_attr")"

	# THE LENGTH BEFORE THE WATERMARK. The IIO core requires the
	# watermark to be no larger than the buffer length and rejects
	# the write otherwise. capture() sets the length and runs after
	# this, so on a freshly loaded driver the length is still at its
	# default and a watermark of 64 is refused with EIO.
	#
	# This worked the first time only because an earlier aborted run
	# had left the length at 256. Reloading the driver reset it and
	# the ordering fault appeared, which is the usual shape of such a
	# fault: invisible on a dirty system and plain on a clean one.
	echo "${BENCH_IIO_BUFLEN:-256}" >"$dev/buffer/length"
	echo "$watermark" >"$wm_attr"
	CLEAN_DEV=$dev

	capture "$dev" "$name" fifo "$hz" driver-interpolated
}

# One capture, used by both buffered paths, so that the only difference
# between the trigger row and the FIFO row is the thing under test.
capture() {
	dev=$1
	name=$2
	path=$3
	hz=$4
	ts_source=$5

	# EVERY scan element, not only the timestamp.
	#
	# A buffer holding a timestamp and no data channel is not a buffer
	# the IIO core will enable. It rejects the configuration with EIO,
	# which arrives as "echo: I/O error" from the line that enables the
	# buffer and says nothing whatever about the cause.
	#
	# This line read "scan_enable $dev in_timestamp" until Thursday 1
	# October 2026, when the program met hardware for the first time.
	# The omission could not surface before: every fixture this program
	# is tested against is a synthetic sysfs tree, where writing to
	# buffer/enable is writing to an ordinary file and no kernel is
	# there to object. A test built from directories can check what a
	# program writes and never what the kernel would make of it.
	#
	# Discovering the channels rather than naming them also keeps this
	# correct for the magnetometer, whose elements are in_magn_* and
	# share no name with the accelerometer's.
	_chans=""
	for _f in "$dev"/scan_elements/*_en; do
		[ -e "$_f" ] || continue
		_n=$(basename "$_f")
		_chans="$_chans ${_n%_en}"
	done
	[ -n "$_chans" ] || die "no scan elements on $(basename "$dev").
       A device with a buffer and no scan_elements directory has nothing
       to put in it, which is a driver fault rather than a usage one."
	# shellcheck disable=SC2086
	scan_enable "$dev" $_chans
	note "channels $_chans"

	echo "${BENCH_IIO_BUFLEN:-256}" >"$dev/buffer/length"

	# WHICH LINE OF /proc/interrupts IS THE DEVICE'S is a property of the
	# driver, not of the device: st_lsm6dsx names its line "lsm6dsx",
	# Project 5's driver names its line after the IIO device. The old
	# default here was "lsm6", which counted nothing for any other driver
	# and reported 0.00 interrupts per second against a buffer that was
	# plainly filling, on Friday 9 October 2026. The default is now the
	# device name, "lsm6" stays as the fallback for the ST driver, and
	# BENCH_IIO_IRQ still overrides both. The pattern used is printed,
	# so a zero can be read against the line it looked for.
	irq_match=${BENCH_IIO_IRQ:-}
	if [ -z "$irq_match" ]; then
		if grep -q "$name" "$PROC/interrupts" 2>/dev/null; then
			irq_match=$name
		else
			irq_match=lsm6
		fi
	fi
	note "irq line   matching \"$irq_match\" in /proc/interrupts"
	# AND SAY WHEN THAT PATTERN IS NOT THIS DEVICE'S, added Saturday 24
	# October 2026. The lsm6 fallback is right for lsm6dsv16x_accel,
	# whose driver names its line lsm6dsx, and wrong for anything else
	# that reaches it: the lis2mdl trigger run printed a count taken
	# from the IMU's line. It read 0.00 because the IMU's FIFO was idle,
	# which is luck rather than correctness, and a concurrent FIFO run
	# would have been reported as the magnetometer's interrupts.
	if [ "$irq_match" = lsm6 ] && [ "${name#lsm6}" = "$name" ]; then
		note "           WARNING: that is st_lsm6dsx's line and NOT"
		note "           $name's. This device has no line of its own in"
		note "           /proc/interrupts, so a non-zero count here"
		note "           belongs to another device. Pass BENCH_IIO_IRQ"
		note "           to name the right line, or read 0 as the only"
		note "           trustworthy value."
	fi
	irq_before=$(irq_count_of "$irq_match")
	raw=$(mktemp)
	CLEAN_DEV=$dev
	CLEAN_RAW=$raw

	# The character device, which is in /dev and not under sysfs. Its
	# name is the sysfs directory's name, which is the one place the two
	# namespaces agree: /sys/bus/iio/devices/iio:device0 is read through
	# /dev/iio:device0.
	chardev=$ROOT/dev/$(basename "$dev")
	[ -e "$chardev" ] || die "no $chardev.
       The device exists in sysfs and has no character device, which means
       CONFIG_IIO_BUFFER is absent or the driver registered no buffer.
       Without it there is nothing to read and only the poll path works."

	echo 1 >"$dev/buffer/enable"
	_start=$(date +%s)
	# The reader runs in the background so that its own CPU time can be
	# read out of /proc before it is reaped. Backgrounding and then
	# waiting is not the same as running it in the foreground: the
	# accounting needs a pid.
	dd if="$chardev" of="$raw" bs=4096 2>/dev/null &
	reader=$!
	sleep "$DURATION"
	ticks=$(cpu_ticks_of "$reader")
	kill "$reader" 2>/dev/null || true
	wait "$reader" 2>/dev/null || true
	_elapsed=$(( $(date +%s) - _start ))
	[ "$_elapsed" -gt 0 ] || _elapsed=1
	echo 0 >"$dev/buffer/enable"

	irq_after=$(irq_count_of "$irq_match")
	irqs=$((irq_after - irq_before))

	# An interrupt counter cannot go backwards during a run. When it does,
	# the measurement is void rather than negative, and every cause is a
	# real one: the counter was reset, the module was reloaded, the IRQ was
	# renumbered onto another line, or /proc/interrupts was read while
	# something was rewriting it.
	#
	# Found on Saturday 3 October 2026 by CI run 37146377402. A test
	# fixture rewritten with ">" was sampled inside its truncation window,
	# irq_after came back 0 against an irq_before of 824, and this program
	# printed "interrupts -824", "-824.00/s" and "ratio -109.9x" as though
	# they were measurements. Three assertions then missed for reasons the
	# output never explained, because the storm check asks whether a ratio
	# is above 2 and a negative one is not.
	irq_void=
	if [ "$irqs" -lt 0 ]; then
		irq_void=yes
		IRQ_VERDICT=fail
		note "FAIL  the interrupt counter went backwards, $irq_before then"
		note "      $irq_after, so this run measured nothing. A counter"
		note "      that falls has been reset, renumbered or read"
		note "      mid-write. It has not counted fewer edges."
	fi

	samples=$(iio-decode "$dev" --raw <"$raw" | tail -n +2 | wc -l)
	cpu_pct=$(awk -v t="$ticks" -v hz="$(clock_ticks)" -v s="$_elapsed" \
		'BEGIN { printf "%.2f", (hz > 0 && s > 0) ? 100 * t / hz / s : 0 }')

	# The timestamp spread, and the column that says where it came from.
	ts_sd=$(iio-decode "$dev" --raw <"$raw" | awk -F, '
		NR == 1 { for (i = 1; i <= NF; i++) if ($i ~ /timestamp/) col = i; next }
		col && NR > 2 { d = $col - prev; n++; s += d; q += d * d }
		col { prev = $col }
		END {
			if (n < 2) { print ""; exit }
			mean = s / n
			printf "%.3f", sqrt((q / n) - (mean * mean)) / 1000
		}')

	emit "$path" "$name" "$((samples / _elapsed))" "$samples" "$_elapsed" \
		"$irqs" "$ts_sd" "$ts_source"
	note "expected   $((hz * _elapsed)) samples at ${hz} Hz"
}

# ------------------------------------------------------------- reporting

emit() {
	path=$1
	device=$2
	rate=$3
	samples=$4
	seconds=$5
	irqs=$6
	ts_sd=$7
	ts_source=$8

	mkdir -p "$RESULTS"
	csv=$RESULTS/rates.csv

	# odr_hz AND watermark ARE THE INDEPENDENT VARIABLES AND WERE MISSING
	# until Saturday 24 October 2026. Nine rows were taken that evening
	# and three of them were identical in every column except irqs: same
	# path, same device, same 460 samples per second, same 2304 samples.
	# Nothing in the file said one was watermark 64, one 32 and one 128,
	# and neither poll row said which output data rate it ran at. The
	# settings existed only in the scrollback of the session that typed
	# them, which makes a results file nobody else can check.
	_header="timestamp,path,device,samples_per_s,samples,seconds,irqs,irqs_per_s,cpu_pct,ts_sd_us,ts_source,odr_hz,watermark"
	if [ ! -f "$csv" ]; then
		echo "$_header" >"$csv"
	elif [ "$(head -n 1 "$csv")" != "$_header" ]; then
		# A card carried from before that change holds the old header.
		# Appending wider rows under it would make one file whose
		# columns mean different things at different line numbers,
		# which is harder to notice and worse to read than two files.
		# The old one is moved aside and never deleted.
		_aside=$RESULTS/rates-$(date +%Y%m%d%H%M%S).csv
		mv "$csv" "$_aside"
		echo "$_header" >"$csv"
		note "note       rates.csv had an older header, so it was moved"
		note "           to $_aside and a new one started."
	fi
	irq_rate=$(awk -v i="$irqs" -v s="$seconds" \
		'BEGIN { printf "%.2f", (s > 0) ? i / s : 0 }')
	printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' \
		"$(date +%Y-%m-%dT%H:%M:%S%z)" "$path" "$device" "$rate" "$samples" \
		"$seconds" "$irqs" "$irq_rate" "${cpu_pct:-}" "$ts_sd" \
		"$ts_source" "${hz:-}" "${watermark:-}" >>"$csv"

	echo
	note "samples/s  $rate  ($samples in ${seconds}s)"
	note "interrupts $irqs  (${irq_rate}/s)"
	# An empty column rather than a zero. A number nobody measured is
	# worse than a blank: the blank is honest, and the zero is a claim
	# the next reader will compare against a figure somebody took.
	if [ -n "${cpu_pct:-}" ]; then
		note "reader cpu ${cpu_pct}%"
	else
		note "reader cpu not measured on this path"
	fi
	if [ -n "$ts_sd" ]; then
		note "ts sd      ${ts_sd} us, source: $ts_source"
		if [ "$ts_source" = driver-interpolated ]; then
			note "           NOT a latency measurement. The driver"
			note "           assigns these from the interrupt time and"
			note "           the configured rate. See docs/DESIGN.md."
		fi
	fi
	# ------------------------------------ criterion 4, checked rather than read
	#
	# A hardware FIFO at rate R with watermark W interrupts R/W times a
	# second. That is arithmetic, not a measurement, and until Thursday 1
	# October 2026 this program printed the measurement beside it and left
	# the division to whoever was reading.
	#
	# They are 30 times apart on this bench: 7.5 per second expected at
	# 480 Hz over a watermark of 64, and 225.60 measured. A control with the
	# interrupt wire unplugged gave 0.00 per second and ZERO SAMPLES, so the
	# extra edges are real and arrive down the wire rather than being picked
	# up by the GPIO.
	#
	# R/W IS A FLOOR AND NOT AN EXPECTATION, corrected Saturday 24 October
	# 2026 after this program spent an evening reporting 1.2x to 1.8x
	# "measured over expected" on runs that were behaving correctly, and
	# inviting the reader to go looking for a fault that was not there.
	#
	# R/W assumes every FIFO entry is a sample. st_lsm6dsx batches a
	# timestamp entry alongside them: in st_lsm6dsx_buffer.c, hw->sip is
	# sip + ts_sip, and with one sensor enabled both are 1, so the pattern
	# is one sample then one timestamp and the threshold is reached after
	# W/2 samples. That DOUBLES the interrupts, to 2R/W.
	#
	# And 2R/W is itself a ceiling rather than a second expectation,
	# because the interrupt fires at the threshold and the handler then
	# drains whatever is present while the FIFO keeps filling during the
	# I2C read. The surplus samples per interrupt grow with the rate, so
	# the measured figure falls back toward the floor as R rises. Measured
	# on this bench at a watermark of 64: 32.0 samples per interrupt at
	# 120 Hz, 39.7 at 480, 52.4 at 960. See
	# projects/10-iio-iks4a1/docs/evidence/rates-2026-10-24.md.
	#
	# So anything between R/W and 2R/W is ordinary. The two guards below
	# are unchanged and were already calibrated to that without saying so:
	# "ratio above 2" is exactly "above the ceiling", which is the ringing
	# line this was written for. Only the labels were wrong.
	#
	# A ratio above 2 exits non-zero. Two is loose on purpose: the point is
	# to catch a wire that rings, not to fail a run that batched slightly
	# differently, and the one fault this has ever seen is a factor of
	# thirty.
	# The ratio is skipped when the counter went backwards, because a
	# ratio computed from a void measurement is the thing the guard above
	# exists to stop being printed.
	if [ "$path" = fifo ] && [ -n "${watermark:-}" ] && [ -z "${irq_void:-}" ]; then
		_expected=$(awk -v h="$hz" -v w="$watermark" 			'BEGIN { printf "%.2f", (w > 0) ? h / w : 0 }')
		_ratio=$(awk -v m="$irq_rate" -v e="$_expected" 			'BEGIN { printf "%.1f", (e > 0) ? m / e : 0 }')
		_ceiling=$(awk -v e="$_expected" 'BEGIN { printf "%.2f", e * 2 }')
		note "irq floor  ${_expected}/s at ${hz} Hz over a watermark of $watermark,"
		note "           if every FIFO entry is a sample"
		note "irq ceil   ${_ceiling}/s if the driver pairs each sample with"
		note "           a timestamp entry, which st_lsm6dsx does. Drain"
		note "           time pushes the measured rate back toward the"
		note "           floor as the rate rises, so anything between"
		note "           these two is ordinary and neither is a target."
		note "position   ${_ratio}x the floor"
		# THE OTHER END OF THE SAME GUARD, added Saturday 17 October
		# 2026. This asked only whether the line was carrying too
		# many edges. A run that carried NONE printed "ratio 0.0x"
		# and passed, beside 984 samples that had to have come from
		# somewhere. Both ends are the same question: does the
		# interrupt rate match what the watermark predicts.
		#
		# Half is the floor, as two is the ceiling, and loose for the
		# same reason. Zero is the case that matters: samples arriving
		# with no interrupts means this is not the FIFO path, whatever
		# the row says.
		if [ "${samples:-0}" -gt 0 ] &&
			[ "$(awk -v r="$_ratio" 'BEGIN { print (r < 0.5) ? 1 : 0 }')" = 1 ]; then
			note "FAIL  samples arrived and the interrupt rate is below"
			note "      half the floor above, so they"
			note "      did not come from the hardware FIFO. The usual"
			note "      cause is a trigger attached to the device: the"
			note "      core then takes the triggered path and the"
			note "      part's FIFO stays in bypass. Check"
			note "      trigger/current_trigger."
			IRQ_VERDICT=fail
		fi

		if [ "$(awk -v r="$_ratio" 'BEGIN { print (r > 2) ? 1 : 0 }')" = 1 ]; then
			note "FAIL  the interrupt rate is above the ceiling above,"
			note "      so the line is carrying edges the FIFO did not"
			note "      ask for. A sample paired with a timestamp entry"
			note "      is the most a correct FIFO can produce, and this"
			note "      is past it. Unplug the wire at the shield"
			note "      and run again: a healthy line gives 0.00 and no"
			note "      samples, which is how the edges were shown to be"
			note "      real rather than GPIO pickup."
			IRQ_VERDICT=fail
		fi
	fi

	note "row        $csv"
}

# -d SEC, anywhere after the mode. The usage line has promised it since
# the program was written and nothing read it until Friday 9 October
# 2026, when two five second captures on Project 5's card each ran for
# the ten second default and said so in their own output. The option
# overrides BENCH_IIO_DURATION, which stays for the tests.
args=""
while [ $# -gt 0 ]; do
	case $1 in
	-d)
		[ $# -ge 2 ] || usage
		case $2 in
		'' | *[!0-9]*) die "-d wants a whole number of seconds, not '$2'" ;;
		esac
		DURATION=$2
		shift 2
		;;
	*)
		args="$args $1"
		shift
		;;
	esac
done
# shellcheck disable=SC2086
set -- $args

case ${1:-} in
poll) shift; [ $# -ge 1 ] || usage; do_poll "$@" ;;
trigger) shift; [ $# -ge 2 ] || usage; do_trigger "$@" ;;
fifo) shift; [ $# -ge 3 ] || usage; do_fifo "$@" ;;
*) usage ;;
esac

# A measurement that disagrees with its own arithmetic is a failure, and
# until this exit existed the only way to notice was to read two lines
# and divide. 3 rather than 1 or 2, which are already the usage and
# missing-device refusals.
[ "${IRQ_VERDICT:-ok}" = ok ] || exit 3
