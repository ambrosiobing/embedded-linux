/*
 * bench-iks4a1: the four supported sensors of an X-NUCLEO-IKS4A1 on I2C1.
 *
 * Declarative binding only. Nothing here probes, configures or reads
 * anything: it tells the kernel which driver owns which address, and the
 * drivers do the rest. That is the whole argument for an overlay over a
 * vendor library, and it is why this file is the entire hardware
 * description for the project.
 *
 * Applied with "dtoverlay=bench-iks4a1" in config.txt, which
 * kas/bench-iio.yml puts there through RPI_EXTRA_CONFIG.
 *
 * WHAT IS NOT HERE, AND WHY
 *
 * The STTS22H answers on the bus and has no node. So does a second LSM6
 * class part at 0x6a, the LSM6DSO16IS. A node naming a compatible string
 * the kernel does not know is not an error: the node is created, nothing
 * binds to it, and the part is invisible with no message anywhere.
 * Leaving them out and listing them in the inventory table is the honest
 * version of the same outcome. Before adding a node for the LSM6DSO16IS,
 * check that the st_lsm6dsx driver in the running kernel lists a matching
 * compatible, rather than assuming one.
 *
 * The LIS2DUXS12 has no node either. It looked intermittent on the bus
 * and was not: it declines the zero-length write that i2cdetect probes
 * with by default, and answers both "i2cdetect -r" and a direct register
 * read. An intermediate version of this comment concluded from one scan
 * that it was not on the shield at all.
 *
 * ADDRESSES, measured Wednesday 30 September 2026 and confirmed against
 * UM3239 Rev 5 Table 1, whose defaults these all are:
 *
 *   0x19  LIS2DUXS12    ADD 33h, needs i2cdetect -r, no node here
 *   0x1e  LIS2MDL       ADD 3Ch, bound below
 *   0x38  STTS22H       ADD 71h, no node here
 *   0x44  SHT40AD1B     ADD 89h, hwmon not IIO, vanishes under -r, bound below
 *   0x5d  LPS22DF       ADD BBh, bound below
 *   0x6a  LSM6DSO16IS   ADD D5h, WHO_AM_I 0x22, ISPU part, no node here
 *   0x6b  LSM6DSV16X    ADD D7h, WHO_AM_I 0x70, fusion part, bound below
 *
 * All seven sit on the main board of the kit, the X-NUCLEO-IQS4A1. The
 * detachable board on top of it, the STEVAL-MKE001A1, carries the Qvar
 * swipe electrodes and puts nothing on this bus (DB5091 Rev 4). The DIL24
 * socket is empty.
 *
 * Six of the seven answering every time is also the proof that the shield
 * is in Mode 1, the standard I2C mode, with J4 and J5 at 1-2 and 11-12.
 * In the sensor-hub modes the environmental parts move behind an IMU and
 * leave this bus entirely.
 *
 * The captures are in the project's docs/evidence directory.
 *
 * SPDX-License-Identifier: MIT
 */

/dts-v1/;
/plugin/;

/ {
	/*
	 * "brcm,bcm2835" is the compatible every Raspberry Pi overlay uses,
	 * including on the BCM2837 of a 3B+ and the BCM2711 of a 4. It
	 * matches the SoC family rather than the part, and the firmware
	 * accepts it on all of them.
	 */
	compatible = "brcm,bcm2835";

	fragment@0 {
		target = <&i2c1>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;

			/*
			 * Redundant with ENABLE_I2C, which puts
			 * dtparam=i2c_arm=on in config.txt, and kept anyway:
			 * this overlay should describe a working bus on its
			 * own, so that moving it to another image does not
			 * silently depend on a setting made somewhere else.
			 */
			status = "okay";

			/*
			 * The IMU, at 0x6b and NOT at 0x6a. This overlay
			 * assumed 0x6a until the bus was read: 0x6a answers
			 * WHO_AM_I 0x22, which is the LSM6DSO16IS, and 0x6b
			 * answers 0x70, which is this part. The driver checks
			 * WHO_AM_I during probe, so the old node found the
			 * wrong value and would have refused to bind, leaving
			 * the part on the bus and absent from IIO.
			 *
			 * One chip, one hardware FIFO, one interrupt
			 * line, and TWO IIO devices: st_lsm6dsx registers
			 * lsm6dsv16x_accel and lsm6dsv16x_gyro separately.
			 * They share the FIFO, so enabling both at different
			 * output data rates changes the FIFO packet pattern
			 * and with it the driver's timestamp reconstruction.
			 *
			 * st,drdy-int-pin selects which of the chip's two
			 * interrupt pins the driver uses for data-ready and
			 * FIFO watermark events. 1 means INT1, which is the
			 * pin UM3239 Rev 5 Table 4 puts on CN9 pin 6, and that
			 * is the pin wired to GPIO24. The other IMU's INT1 is
			 * on CN8 pin 6, so the two are easy to confuse.
			 * Getting this wrong gives a
			 * device that probes, reads fine through sysfs, and
			 * never fills a buffer, because the interrupt the
			 * driver waits on is on a pin nothing is connected
			 * to.
			 */
			imu: lsm6dsv16x@6b {
				compatible = "st,lsm6dsv16x";
				reg = <0x6b>;
				interrupt-parent = <&gpio>;
				interrupts = <24 1>;	/* GPIO24, rising edge */
				st,drdy-int-pin = <1>;
			};

			/*
			 * The magnetometer. No FIFO of its own, which is
			 * exactly why it is the device the hrtimer trigger is
			 * demonstrated on: there is no hardware path to
			 * confuse the comparison with.
			 */
			magn: lis2mdl@1e {
				compatible = "st,lis2mdl";
				reg = <0x1e>;
			};

			/* Pressure. Polled, or driven by the same trigger. */
			press: lps22df@5d {
				compatible = "st,lps22df";
				reg = <0x5d>;
			};

			/*
			 * Humidity and temperature, and NOT an IIO device.
			 * sht4x is a hwmon driver, so this part appears under
			 * /sys/class/hwmon and in sensors(1), and never under
			 * /sys/bus/iio/devices. A program that enumerates IIO
			 * devices looking for humidity finds nothing and
			 * reports no error.
			 */
			hum: sht4x@44 {
				compatible = "sensirion,sht4x";
				reg = <0x44>;
			};
		};
	};
};
