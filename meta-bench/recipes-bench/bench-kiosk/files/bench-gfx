#!/bin/sh
# bench-gfx - walk the graphics stack, one layer at a time.
#
#   bench-gfx            every layer, in stack order
#   bench-gfx drm        which card has the connectors, and its state
#   bench-gfx input      touch and keyboard devices, and their names
#   bench-gfx compositor what weston did, from the journal
#   bench-gfx client     is the dashboard running, on which socket
#
# THE POINT OF THIS SCRIPT
#
# docs/DESIGN.md has a table of nine layers and the one tool that answers
# for each. This is that table, runnable. Every graphics failure on this
# board lives at exactly one layer, and the fastest way to find which is
# to ask each layer in turn rather than to guess from the symptom.
#
# IT NAMES WHAT IT COULD NOT ASK. Every check here can be unanswerable:
# the tool may not be installed, the debugfs mount may be absent, the
# journal may have rotated. A check that silently skips is worse than no
# check, because a clean run then means two different things. Each block
# says explicitly when the question could not be put.
#
# SPDX-License-Identifier: MIT

set -u

ok()      { printf '  ok      %s\n' "$*"; }
bad()     { printf '  PROBLEM %s\n' "$*"; }
note()    { printf '          %s\n' "$*"; }
unasked() { printf '  unasked %s\n' "$*"; }
head2()   { printf '\n== %s\n' "$*"; }

have() { command -v "$1" >/dev/null 2>&1; }

# ---------------------------------------------------------------- drm
layer_drm() {
	head2 "DRM and KMS"

	if [ ! -d /sys/class/drm ]; then
		bad "/sys/class/drm does not exist: no DRM driver is loaded"
		note "check: dmesg | grep -iE 'vc4|v3d'"
		return
	fi

	# Which card carries a connected connector. This is the question
	# that a compositor reporting "no outputs" is really asking.
	found=0
	for status in /sys/class/drm/card*-*/status; do
		[ -e "$status" ] || continue
		conn=$(dirname "$status")
		name=$(basename "$conn")
		state=$(cat "$status" 2>/dev/null || echo unreadable)
		card=${name%%-*}
		if [ "$state" = connected ]; then
			ok "$name is connected (on $card)"
			found=1
			modes=$(head -n 1 "$conn/modes" 2>/dev/null)
			[ -n "$modes" ] && note "first mode: $modes"
		else
			note "$name is $state"
		fi
	done

	[ "$found" -eq 1 ] || bad "no connected connector on any card"

	# The two-cards trap, stated explicitly rather than left implied.
	# Counted with a glob rather than by piping ls, whose output
	# format is not a stable interface (SC2012).
	cards=0
	for card in /sys/class/drm/card[0-9]*; do
		[ -e "$card" ] || continue
		cards=$((cards + 1))
	done
	note "$cards DRM card(s) present; on a Pi 4 one is vc4 (connectors)"
	note "and one is v3d (render only). A compositor on the v3d node"
	note "reports 'no outputs' and nothing else."

	if have drm_info; then
		note "for the full picture: drm_info"
	else
		unasked "drm_info is not installed, so connector properties,"
		note "planes and the DRM master holder were not inspected"
	fi

	# The atomic state, which shows whether anything is actually
	# being composited.
	state_file=""
	for candidate in /sys/kernel/debug/dri/*/state; do
		if [ -e "$candidate" ]; then
			state_file=$candidate
			break
		fi
	done
	if [ -n "$state_file" ]; then
		if [ -r "$state_file" ]; then
			planes=$(grep -c '^plane\[' "$state_file" 2>/dev/null || echo 0)
			ok "atomic state readable at $state_file ($planes plane entries)"
		else
			unasked "$state_file exists but is not readable (run as root)"
		fi
	else
		unasked "no debugfs dri state: is debugfs mounted?"
	fi
}

# -------------------------------------------------------------- input
layer_input() {
	head2 "Input devices"

	if [ ! -d /sys/class/input ]; then
		unasked "/sys/class/input does not exist"
		return
	fi

	touch_found=0
	kbd_found=0
	for dev in /sys/class/input/event*; do
		[ -e "$dev/device/name" ] || continue
		name=$(cat "$dev/device/name" 2>/dev/null)
		node=/dev/input/$(basename "$dev")
		case $name in
		*FT5406* | *ft5x06* | *raspberrypi-ts* | *[Tt]ouch*)
			ok "touch: $node  name='$name'"
			note "that name is what a udev calibration rule must match"
			touch_found=1
			;;
		*[Kk]eyboard* | *[Kk]bd*)
			ok "keyboard: $node  name='$name'"
			kbd_found=1
			;;
		*)
			note "other: $node  name='$name'"
			;;
		esac
	done

	[ "$touch_found" -eq 1 ] || bad "no touch device found under /sys/class/input"
	[ "$kbd_found" -eq 1 ] || note "no keyboard found (the project works without one)"

	if have libinput; then
		note "next: libinput debug-events --verbose, then touch the"
		note "TOP LEFT of the picture and read the coordinates"
	else
		unasked "libinput is not installed, so the calibration and the"
		note "output mapping were not checked; evdev only was inspected"
	fi
}

# --------------------------------------------------------- compositor
layer_compositor() {
	head2 "Compositor"

	if ! have systemctl; then
		unasked "no systemctl, so the unit state was not checked"
		return
	fi

	state=$(systemctl is-active weston.service 2>/dev/null || true)
	case $state in
	active) ok "weston.service is active" ;;
	*)      bad "weston.service is $state" ;;
	esac

	if have journalctl; then
		# The two failures that look like something else.
		if journalctl -u weston.service -b --no-pager 2>/dev/null |
				grep -qi 'could not connect to seat'; then
			bad "weston could not connect to a seat"
			note "This is NOT a permission problem on /dev/dri."
			note "The seat comes from logind through the unit's PAM"
			note "session; if libseat has no logind backend, run"
			note "seatd and set LIBSEAT_BACKEND=seatd."
		fi
		if journalctl -u weston.service -b --no-pager 2>/dev/null |
				grep -qi 'no outputs'; then
			bad "weston found no outputs: it opened the wrong DRM card"
			note "The v3d node has no connectors. See the drm section."
		fi
		backend=$(journalctl -u weston.service -b --no-pager 2>/dev/null |
			grep -i 'backend' | tail -n 1)
		[ -n "$backend" ] && note "backend line: $backend"
	else
		unasked "no journalctl, so the compositor log was not read"
	fi
}

# ------------------------------------------------------------- client
layer_client() {
	head2 "Client"

	if pgrep -x bench-hmi >/dev/null 2>&1; then
		ok "bench-hmi is running"
	else
		bad "bench-hmi is not running"
		note "weston.ini autolaunches it; check [autolaunch] path="
	fi

	sock=""
	for candidate in /run/user/*/wayland-*; do
		# The glob also matches wayland-0.lock, which is not the
		# socket. Only the socket answers -S.
		if [ -S "$candidate" ]; then
			sock=$candidate
			break
		fi
	done
	if [ -n "$sock" ]; then
		ok "wayland socket: $sock"
	else
		unasked "no wayland socket found under /run/user/*/"
		note "the compositor may run with a different XDG_RUNTIME_DIR"
	fi

	if have wayland-info; then
		note "next: run wayland-info as the weston user and confirm"
		note "xdg_wm_base is offered and wl_seat has touch capability"
	else
		unasked "wayland-info is not installed, so the compositor's"
		note "advertised globals were not checked"
	fi

	note "protocol trace, ON THE CLIENT ONLY:"
	note "  WAYLAND_DEBUG=1 bench-hmi 2>&1 | head -n 50"
	note "Setting it on the compositor floods the journal with every"
	note "frame of every client and buries what you were looking for."
}

case "${1:-all}" in
drm)        layer_drm ;;
input)      layer_input ;;
compositor) layer_compositor ;;
client)     layer_client ;;
all)
	layer_drm
	layer_input
	layer_compositor
	layer_client
	printf '\n'
	;;
*)
	echo "usage: bench-gfx [drm | input | compositor | client]" >&2
	exit 2
	;;
esac
