#!/bin/sh
#
# bench-router-setup - instantiate the NetworkManager profiles from
# identity left on the boot partition.
#
# The image carries the capability to be a router. The card carries the
# identity: which access point name to announce, which passphrase protects
# it, and which APN this SIM wants. None of those belong in a repository,
# and two of them are credentials.
#
# /boot/router.conf holds up to six lines:
#
#   AP_SSID=bench-lte
#   AP_PSK=at-least-eight-characters
#   APN=internet
#   PIN=1234                       optional, only if the SIM keeps its PIN
#   WAN_SSID=HomeNetwork           optional, the wireless uplink
#   WAN_PSK=...                    optional, its passphrase
#
# The PIN is optional and absent by default. A SIM that keeps its PIN needs
# that PIN sent after every power cut, and a box needing a person present
# after a power cut is not a router. Disabling the PIN on the SIM is the
# other answer; this one leaves the SIM as it is and lets NetworkManager
# send the code, from a keyfile only root can read.
#
# The APN comes from the carrier. A wrong APN produces a modem that
# registers and never connects, which reads like an antenna problem and is
# not one, so it is worth checking this line before climbing on a roof.
#
# The templates in /usr/share/bench-router are shipped by the image; this
# script only substitutes and installs them, so re-running it is safe and
# is the documented way to change the access point name.
#
# SPDX-License-Identifier: MIT

set -eu

SRC=${BENCH_ROUTER_SOURCE:-/boot/router.conf}
DST=${BENCH_ROUTER_TARGET:-/etc/NetworkManager/system-connections}
TEMPLATES=${BENCH_ROUTER_TEMPLATES:-/usr/share/bench-router}

if [ ! -r "$SRC" ]; then
	echo "bench-router-setup: no $SRC, leaving the profiles as shipped"
	exit 0
fi

ap_ssid=
ap_psk=
apn=
pin=
wan_ssid=
wan_psk=

# The three Windows text traps, all of which this bench has walked into:
# CRLF endings, a UTF-8 byte order mark on the first key, and a final line
# with no newline, which ends a plain "while read" before the body runs and
# silently drops the last key. See bench-wifi-setup, which learned the same
# lesson the expensive way.
while IFS='=' read -r key value || [ -n "$key" ]; do
	key=$(printf '%s' "$key" | tr -cd 'A-Za-z0-9_')
	case $key in
	AP_SSID) ap_ssid=$value ;;
	AP_PSK) ap_psk=$value ;;
	APN) apn=$value ;;
	PIN) pin=$value ;;
	WAN_SSID) wan_ssid=$value ;;
	WAN_PSK) wan_psk=$value ;;
	esac
done <"$SRC"

ap_ssid=$(printf '%s' "$ap_ssid" | tr -d '\r')
ap_psk=$(printf '%s' "$ap_psk" | tr -d '\r')
apn=$(printf '%s' "$apn" | tr -d '\r')
pin=$(printf '%s' "$pin" | tr -d '\r')
wan_ssid=$(printf '%s' "$wan_ssid" | tr -d '\r')
wan_psk=$(printf '%s' "$wan_psk" | tr -d '\r')

# Substitute one placeholder. sed would need every value escaped for the
# replacement side, and a passphrase is exactly the kind of string that
# contains an ampersand or a slash, so the substitution is done in the
# shell instead.
substitute() {
	placeholder=$1
	value=$2
	while IFS= read -r line || [ -n "$line" ]; do
		case $line in
		*"$placeholder"*)
			before=${line%%"$placeholder"*}
			after=${line#*"$placeholder"}
			printf '%s%s%s\n' "$before" "$value" "$after"
			;;
		*) printf '%s\n' "$line" ;;
		esac
	done
}

mkdir -p "$DST"
umask 077
written=

# Drop any line still carrying a placeholder that has no value. An empty
# NetworkManager key is not the same as an absent one: "pin=" with
# nothing after it is a zero-length PIN, which the modem rejects.
drop_placeholder() {
	placeholder=$1
	while IFS= read -r line || [ -n "$line" ]; do
		case $line in
		*"$placeholder"*) ;;
		*) printf '%s\n' "$line" ;;
		esac
	done
}

# The access point is written first, before the two optional profiles,
# and that ordering is deliberate rather than tidy.
#
# This script runs under set -e, so any failure below stops it. When a
# template for one of the optional profiles was missing from the image,
# the script died before reaching this block, no access point profile was
# written, and the only way back into a board with no Ethernet cable was
# the console. An optional feature took out the recovery path.
#
# So the way in gets written first. If anything below fails you still
# have an access point, an ssh server and a board you can fix.
if [ -n "$ap_ssid" ] && [ -n "$ap_psk" ]; then
	# NetworkManager rejects a WPA passphrase shorter than 8 characters,
	# and it does so at activation time, so the access point simply never
	# appears. Say it here instead, where the message is readable.
	if [ "${#ap_psk}" -lt 8 ]; then
		echo "bench-router-setup: AP_PSK is shorter than 8 characters" >&2
		exit 1
	fi
	substitute '@AP_SSID@' "$ap_ssid" \
		<"$TEMPLATES/bench-ap.nmconnection.in" >"$DST/.ap.stage"
	substitute '@AP_PSK@' "$ap_psk" \
		<"$DST/.ap.stage" >"$DST/bench-ap.nmconnection.new"
	rm -f "$DST/.ap.stage"
	mv -f "$DST/bench-ap.nmconnection.new" "$DST/bench-ap.nmconnection"
	chmod 600 "$DST/bench-ap.nmconnection"
	written="$written bench-ap"
elif [ -n "$ap_ssid" ] || [ -n "$ap_psk" ]; then
	echo "bench-router-setup: $SRC needs both AP_SSID and AP_PSK" >&2
	exit 1
fi

if [ -n "$apn" ]; then
	substitute '@APN@' "$apn" \
		<"$TEMPLATES/lte.nmconnection.in" >"$DST/.gsm.stage"
	if [ -n "$pin" ]; then
		substitute '@PIN@' "$pin" \
			<"$DST/.gsm.stage" >"$DST/lte.nmconnection.new"
	else
		drop_placeholder '@PIN@' \
			<"$DST/.gsm.stage" >"$DST/lte.nmconnection.new"
	fi
	rm -f "$DST/.gsm.stage"
	mv -f "$DST/lte.nmconnection.new" "$DST/lte.nmconnection"
	chmod 600 "$DST/lte.nmconnection"
	written="$written lte"
fi

# The wireless uplink, if this bench is standing one in for the Ethernet
# cable it does not have. Both keys or neither: an SSID with no
# passphrase produces a profile NetworkManager will never activate,
# and it fails at activation time where nobody is reading.
if [ -n "$wan_ssid" ] && [ -n "$wan_psk" ]; then
	if [ "${#wan_psk}" -lt 8 ]; then
		echo "bench-router-setup: WAN_PSK is shorter than 8 characters" >&2
		exit 1
	fi
	substitute '@WAN_SSID@' "$wan_ssid" \
		<"$TEMPLATES/wan-wifi.nmconnection.in" >"$DST/.wan.stage"
	substitute '@WAN_PSK@' "$wan_psk" \
		<"$DST/.wan.stage" >"$DST/wan-wifi.nmconnection.new"
	rm -f "$DST/.wan.stage"
	mv -f "$DST/wan-wifi.nmconnection.new" "$DST/wan-wifi.nmconnection"
	chmod 600 "$DST/wan-wifi.nmconnection"
	written="$written wan-wifi"
elif [ -n "$wan_ssid" ] || [ -n "$wan_psk" ]; then
	echo "bench-router-setup: $SRC needs both WAN_SSID and WAN_PSK" >&2
	exit 1
fi


if [ -z "$written" ]; then
	echo "bench-router-setup: $SRC named nothing to configure" >&2
	exit 1
fi

echo "bench-router-setup: wrote$written"
